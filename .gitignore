# Secrets — never commit
.env
.env.*
!.env.example

# Node
node_modules/
**/node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
apps/web/dist/
apps/api/dist/
dist/
build/
.vite/

# Next.js build output (regenerable — this was showing up as 10k+ "changes")
.next/
**/.next/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Native-shell (Tauri desktop) build artifacts — left in the worktree as
# leftovers from the native-shell branch; regenerable, thousands of files.
apps/desktop/src-tauri/target*/
apps/desktop/src-tauri/gen/

# Python venv + caches
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Local audio cache (large, regenerable)
my_music/

# PocketBase — binary (per-platform) + data (per-user)
pocketbase/pocketbase
pocketbase/pb_data/
pocketbase/pb_public/

# Bug-report logger JSONL output (rotates every 2 days), plus the daily
# digest's "already sent today" markers. Anchored to the repo root on
# purpose: a bare `logs/` also matched app/api/admin/logs and
# app/(app)/admin/logs, which silently hid real app routes from git.
/logs/

# Internal design docs / brainstorming notes — local only
docs/superpowers/
docs/deslop/
docs/DESLOP.md
CHANGES.md

# Bug-hunt reports / dossiers — local only
docs/reports/
ember-bug-dossier.txt

# Claude Code local settings — local only
.claude/

# Legacy Supabase schema — unused, local only
supabase/

# Router plugin local state — local only
.router/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Misc
.cache/
coverage/
.nyc_output/
cookies.txt

# Local roadmap / status notes — not committed
ROADMAP.md

# Local project rules / app reference / agent docs — not committed
/RULES.md
/EMBER.md
/FIXES-TEST-PLAN.md

# Android release signing — NEVER commit (docs/APPS.md explains regeneration)
apps/mobile/android/ember-release.keystore
apps/mobile/android/keystore.properties

# Desktop updater signing key — NEVER commit. Unlike the Android keystore this
# one CANNOT be regenerated without breaking auto-update for everyone already
# running Ember: the installed app only trusts updates signed by this exact
# key. Back it up somewhere real (password manager), not just this folder.
apps/desktop/.keys/

# Written by update.sh after a successful npm ci.
.node_modules.stamp

# worktrees symlink node_modules into the main checkout; a symlink is a file,
# so the directory-only pattern above does not catch it
node_modules

# AI assistant instruction files stay local, never published
CLAUDE.md
AGENTS.md
GEMINI.md
.codex/
.cursor/
docs/TESTING.md
