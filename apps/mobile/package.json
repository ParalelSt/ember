{
  "name": "mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Thin Capacitor webview wrapper that loads Ember's LIVE server URL (set via EMBER_APP_URL). Ember is a Next.js server app and cannot be statically bundled, so nothing is built into the app.",
  "scripts": {
    "apk": "bash scripts/build-apk.sh",
    "sync": "cap sync",
    "sync:ios": "cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/core": "^7.6.7",
    "@capacitor/ios": "^7.6.7",
    "@capgo/capacitor-media-session": "^7.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7"
  }
}
