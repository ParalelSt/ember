<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:remove="android:usesCleartextTraffic"
        android:theme="@style/AppTheme">
        <!-- No cleartext except to an http:// Ember server itself: the config
             is generated from the server URL (app/network-security.gradle).
             Capacitor's generated cordova-plugins manifest sets
             usesCleartextTraffic="true" on every sync; it is removed here so
             nothing but the config decides. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- The native player. Exported because Android Auto and the car's
             Media Center bind to it from another process. -->
        <service
            android:name=".EmberPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />

        <!-- Media buttons with the app closed (the car's play button over
             Bluetooth, a headset, a mirroring app's steering-wheel keys):
             Android sends them here, and it starts the player service to
             resume the saved queue (EmberMediaButtonReceiver). Media3 wants
             exactly one MEDIA_BUTTON receiver in the app, so the old
             androidx.media one that @capgo/capacitor-media-session brings is
             removed, and so is its service's MEDIA_BUTTON filter (the
             receiver would otherwise start that service instead). -->
        <receiver
            android:name=".EmberMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            tools:node="remove" />
        <service android:name="com.capgo.mediasession.MediaSessionService">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Covers on the Ember server for the car's lists (ArtworkProvider):
             exported because Android Auto reads them from its own process;
             it answers only the callers the player service lets in. -->
        <provider
            android:name=".ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />

        <!-- Casting (CastSupport.kt): Google's Default Media Receiver, with
             Media3's session as the only one. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.ember.music.EmberCastOptions" />
        <!-- Lists Ember's cast devices in Android 13+'s own output switcher
             (the media output dialog), and lets it move a cast session back
             to the phone (EmberCastOptions: remote-to-local). From
             androidx.mediarouter. -->
        <receiver
            android:name="androidx.mediarouter.media.MediaTransferReceiver"
            android:exported="true" />

        <!-- Pinned downloads keep running with the app closed, so they need a
             foreground service; dataSync is the type Android 14+ expects for
             "fetching files the user asked for". -->
        <service
            android:name=".OfflineDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The auto cache and the offline skip watch for a validated network
         (NetworkWatch), and never prefetch on mobile data unless allowed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The player keeps the CPU and Wi-Fi awake while it streams with the
         screen off (ExoPlayer's WAKE_MODE_NETWORK), and only then. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Both foreground services need the generic permission (declared once),
         plus the typed one Android 14+ requires for their service type:
         mediaPlayback for EmberPlaybackService, dataSync for
         OfflineDownloadService. POST_NOTIFICATIONS covers the notifications
         both of them post. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice search (EmberSpeechPlugin), asked for on the first mic tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility: without this the system recognizer
         service is invisible and isRecognitionAvailable() is always false. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
