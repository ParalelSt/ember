<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:remove="android:usesCleartextTraffic"
        android:theme="@style/AppTheme">
        <!-- No cleartext except to an http:// Ember server itself: the config
             is generated from the server URL (app/network-security.gradle).
             Capacitor's generated cordova-plugins manifest sets
             usesCleartextTraffic="true" on every sync; it is removed here so
             nothing but the config decides. -->

        <!-- The app itself (Capacitor's WebView, the plugins, the player).
             Started by the launch gate below, not by the launcher. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".EmberActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="false" />

        <!-- The launch gate (LaunchGateActivity, GateRules): a launcher tap
             asks the server for an update before the WebView or the player
             exist, and offers it with "Not now". -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".LaunchGateActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:exported="false" />

        <!-- The home screen icon. Its component name stays .MainActivity,
             which is what launchers pinned before the gate existed: a
             launcher drops a pinned icon whose component is gone. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".LaunchGateActivity"
            android:label="@string/title_activity_main"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <!-- The native player. Exported because Android Auto and the car's
             Media Center bind to it from another process. -->
        <service
            android:name=".EmberPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <!-- "Scan QR code" (QrScan.kt): Play services fetches Google's code
             scanner module when the app is installed, not on the first scan. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />

        <!-- Media buttons with the app closed (the car's play button over
             Bluetooth, a headset, a mirroring app's steering-wheel keys):
             Android sends them here, and it starts the player service to
             resume the saved queue (EmberMediaButtonReceiver). Media3 wants
             exactly one MEDIA_BUTTON receiver in the app, so the old
             androidx.media one that @capgo/capacitor-media-session brings is
             removed, and so is its service's MEDIA_BUTTON filter (the
             receiver would otherwise start that service instead). -->
        <receiver
            android:name=".EmberMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            tools:node="remove" />
        <service android:name="com.capgo.mediasession.MediaSessionService">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Covers on the Ember server for the car's lists (ArtworkProvider):
             exported because Android Auto reads them from its own process;
             it answers only the callers the player service lets in. -->
        <provider
            android:name=".ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />

        <!-- Casting (CastSupport.kt): Google's Default Media Receiver, with
             Media3's session as the only one. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.ember.music.EmberCastOptions" />
        <!-- Lists Ember's cast devices in Android 13+'s own output switcher
             (the media output dialog), and lets it move a cast session back
             to the phone (EmberCastOptions: remote-to-local). From
             androidx.mediarouter. -->
        <receiver
            android:name="androidx.mediarouter.media.MediaTransferReceiver"
            android:exported="true" />

        <!-- Pinned downloads keep running with the app closed, so they need a
             foreground service; dataSync is the type Android 14+ expects for
             "fetching files the user asked for". -->
        <service
            android:name=".OfflineDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The in-app updater (AppUpdater.kt): a check every 6 hours with
             the app closed too, and the install session's answer. Neither
             is exported; the job binds through the system's permission and
             the receiver only hears its own PendingIntent. -->
        <service
            android:name=".UpdateCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />
        <!-- Android does not reopen an app that updated itself: after an
             update from the launch gate, a notification offers to (S3). -->
        <receiver
            android:name=".UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The auto cache and the offline skip watch for a validated network
         (NetworkWatch), and never prefetch on mobile data unless allowed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The player keeps the CPU and Wi-Fi awake while it streams with the
         screen off (ExoPlayer's WAKE_MODE_NETWORK), and only then. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Both foreground services need the generic permission (declared once),
         plus the typed one Android 14+ requires for their service type:
         mediaPlayback for EmberPlaybackService, dataSync for
         OfflineDownloadService. POST_NOTIFICATIONS covers the notifications
         both of them post. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice search (EmberSpeechPlugin), asked for on the first mic tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "Scan QR code" when Google's scanner is missing (no Play services):
         the page's own scanner asks for the camera on first use. Google's
         scanner itself needs no permission. A camera is not required. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The in-app updater (AppUpdater.kt) installs Ember's own next APK
         with a PackageInstaller session. REQUEST_INSTALL_PACKAGES is the
         "Install unknown apps" switch; UPDATE_PACKAGES_WITHOUT_USER_ACTION
         (Android 13+) lets an update Ember is the installer of record for go
         in without a dialog; RECEIVE_BOOT_COMPLETED keeps the 6-hourly check
         (UpdateCheckJob) scheduled across a reboot. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ package visibility: without this the system recognizer
         service is invisible and isRecognitionAvailable() is always false. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
