{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember",
  "version": "0.1.0",
  "identifier": "app.ember.desktop",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
