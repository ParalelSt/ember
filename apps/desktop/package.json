{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ember Tauri 2 desktop shell \u2014 loads the live Ember server URL in a native window.",
  "scripts": {
    "prepare:url": "node scripts/set-url.mjs",
    "dev": "npm run prepare:url && tauri dev",
    "build": "npm run prepare:url && tauri build",
    "tauri": "tauri",
    "build:signed": "bash scripts/build-signed.sh",
    "build:mac": "bash scripts/build-mac.sh",
    "build:mac:local": "bash scripts/build-mac.sh --local"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
