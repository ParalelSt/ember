      },
      "expectedDesired": ["youtube:b", "youtube:c", "youtube:d"],
      "expectedAction": { "kind": "idle", "reason": "cap" }
    },
    {
      "name": "window entries are not reclaimable: the cap holds",
      "input": {
        "cached": ["youtube:b", "youtube:c"],
        "sizes": { "youtube:b": 100000000, "youtube:c": 100000000 },
        "bytes": 200000000,
