      "name": "everything cached: nothing",
      "input": { "cached": ["youtube:b", "youtube:c", "youtube:d"] },
      "expectedDesired": ["youtube:b", "youtube:c", "youtube:d"],
      "expectedAction": { "kind": "idle", "reason": "nothing" }
