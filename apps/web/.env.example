# PocketBase — see SETUP.md for the setup story.
#
# POCKETBASE_URL (server-side): where the real PocketBase server lives. Used by
# route handlers, middleware, and the Next /pb proxy target. Keep as localhost.
POCKETBASE_URL=http://127.0.0.1:8090
#
# NEXT_PUBLIC_POCKETBASE_URL (browser): leave as the same-origin /pb proxy so
# the app needs only ONE public URL. Override with an absolute URL only if you
# expose PocketBase on its own separate public host.
NEXT_PUBLIC_POCKETBASE_URL=/pb

# Jamendo (Creative Commons music) — required for /search empty fallback + tracks/:id.
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Optional. Set to your Discord app ID to enable rich presence (rate-limited 1/15s).
DISCORD_APP_ID=

# Optional. 'cache' (download to my_music/ first) or 'proxy' (default; live stream).
STREAM_MODE=proxy

# Optional. Override the bundled Python venv + player.py paths.
# PYTHON_BIN=
# PLAYER_SCRIPT=
# MUSIC_DIR=

# Optional. Leave empty for same-origin web build; set for native (Capacitor) shells.
NEXT_PUBLIC_API_BASE_URL=
