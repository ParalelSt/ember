# Supabase — exposed to the browser (NEXT_PUBLIC_*) so client + server share auth.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — service role key bypasses RLS, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Jamendo (Creative Commons music) — required for /search empty fallback + tracks/:id.
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Optional. Set to your Discord app ID to enable rich presence (rate-limited 1/15s).
DISCORD_APP_ID=

# Optional. 'cache' (download to my_music/ first) or 'proxy' (default; live stream).
STREAM_MODE=proxy

# Optional. Override the bundled Python venv + player.py paths.
# PYTHON_BIN=
# PLAYER_SCRIPT=
# MUSIC_DIR=

# Optional. Leave empty for same-origin web build; set for native (Capacitor) shells.
NEXT_PUBLIC_API_BASE_URL=
