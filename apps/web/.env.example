# ═══════════════════════════════════════════════════════════════════
# REQUIRED — the app won't start the invite-only auth flow without these
# ═══════════════════════════════════════════════════════════════════

# PocketBase super-admin credentials. These MUST match the values in
# pocketbase/pb_hooks/ensure_superuser.pb.js — that hook auto-creates
# the matching super-admin on every PB boot, so the defaults below
# work on a fresh deployment without any manual /_/ setup.
# Friends self-hosting who change the hook should change these too.
# /api/auth/check-email logs into PB with these to read the
# `allowed_emails` collection. Mismatch → /auth shows
# "Failed to authenticate as PB admin" or "PocketBase admin credentials not configured".
POCKETBASE_ADMIN_EMAIL=admin@ember.com
POCKETBASE_ADMIN_PASSWORD=egKa5WNMx3QpuG7

# Where the real PocketBase server lives (server-side reads only).
# Leave as localhost unless PB runs on a separate host.
POCKETBASE_URL=http://127.0.0.1:8090

# Browser-facing PB URL. Leave as the same-origin /pb proxy so the whole
# app lives on one public URL. Override with an absolute URL only if you
# expose PB on its own host.
NEXT_PUBLIC_POCKETBASE_URL=/pb

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — defaults work, edit only if you need the feature
# ═══════════════════════════════════════════════════════════════════

# Ports. start-static.sh reads these from this file. POCKETBASE_PORT
# also rewrites POCKETBASE_URL above on each boot, so changing it here
# is enough — no other edits needed. See PORTS.md for details.
# PORT=3000
# POCKETBASE_PORT=8090

# Jamendo (Creative Commons music) — used by /search empty fallback and
# /api/tracks/[id]. Leave the placeholder if you don't care about Jamendo.
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Anthropic (Claude) API key. Optional — two features use it:
#   1. AI triage of bug reports (SETUP.md → "Bug reports"). Without a key,
#      reports send as normal, just without the diagnosis.
#   2. The AI-fallback lyrics generator documented in LYRICS_AI.md (planned).
ANTHROPIC_API_KEY=

# Model for bug-report triage. Default claude-sonnet-5; set
# claude-haiku-4-5-20251001 for a cheaper, shallower read.
# BUG_TRIAGE_MODEL=

# Anthropic API base URL. Only for pointing tests at a fake server.
# ANTHROPIC_BASE_URL=

# Desktop auto-update. The desktop apps ask THIS server whether a newer build
# exists; the server answers from the GitHub Release and streams the installer
# back. The repo is private, so it needs a read-only token — kept here on the
# host, never shipped inside the app.
#
# Make one at github.com/settings/tokens (fine-grained) → this repo only →
# Repository permissions → Contents: Read-only.
# Without it the feed just reports "no update" and the apps keep working.
GITHUB_RELEASES_TOKEN=
# Override only if the repo moves, or for tests against a fake API.
# GITHUB_RELEASES_REPO=ParalelSt/ember
# GITHUB_API_BASE=https://api.github.com

# Discord rich presence — rate-limited 1/15s.
DISCORD_APP_ID=

# Bug-report Discord webhook. Owner: edit DEFAULT_WEBHOOK_URL in
# apps/web/app/api/bug-report/route.ts to ship the bug-report channel
# baked into source. Anyone else: set this env var to override per
# deployment. Without either → "Report a bug" returns a 503.
DISCORD_BUG_REPORT_WEBHOOK_URL=

# Python venv + player.py + cache dir overrides. Only set if your layout
# differs from the bundled .venv/. MUSIC_DIR also controls where the
# YouTube stream proxy looks for cached audio files.
# PYTHON_BIN=
# PLAYER_SCRIPT=
# MUSIC_DIR=

# Same-origin web build leaves this empty. Native (Capacitor) shells set
# it to the server's absolute URL.
NEXT_PUBLIC_API_BASE_URL=
