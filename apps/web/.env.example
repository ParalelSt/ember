# ═══════════════════════════════════════════════════════════════════
# REQUIRED — the app won't start the invite-only auth flow without these
# ═══════════════════════════════════════════════════════════════════

# PocketBase superuser. The server signs in with it (e.g. /api/auth/check-email
# reads the invite list), and start-static.sh hands these same two values to
# PocketBase, whose pb_hooks/ensure_superuser.pb.js creates the superuser or
# sets its password to match on every boot. So this is the ONE place to set
# them: change the password here, restart with ./start-static.sh (or
# ./update.sh), and both sides move together.
#
# Pick your own long random password, letters and digits only, e.g.
#   openssl rand -base64 24 | tr -d '/+='
# Never reuse a password that has been in the repo: it is public.
# Blank password: PocketBase's superuser is left exactly as it is (nothing is
# created or reset) and /auth shows "PocketBase admin credentials not configured".
# Starting PocketBase by hand instead of start-static.sh? Pass the same values
# to it as EMBER_PB_SUPERUSER_EMAIL / EMBER_PB_SUPERUSER_PASSWORD.
POCKETBASE_ADMIN_EMAIL=admin@ember.com
POCKETBASE_ADMIN_PASSWORD=

# Optional: the owner's app account (the one with the Admin menu). Created once,
# on a database that doesn't have it yet, by pb_hooks/ensure_admin.pb.js.
# EMBER_ADMIN_PASSWORD is only its FIRST password: it never overwrites one the
# owner has changed since. Blank: nothing is created.
# EMBER_ADMIN_EMAIL=
# EMBER_ADMIN_PASSWORD=

# Where the real PocketBase server lives (server-side reads only).
# Leave as localhost unless PB runs on a separate host.
POCKETBASE_URL=http://127.0.0.1:8090

# Browser-facing PB URL. Leave as the same-origin /pb proxy so the whole
# app lives on one public URL. Override with an absolute URL only if you
# expose PB on its own host, and then keep its /_/ admin UI and /api/admins
# off the internet yourself: the /pb proxy refuses both (bughunt W14).
NEXT_PUBLIC_POCKETBASE_URL=/pb

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — defaults work, edit only if you need the feature
# ═══════════════════════════════════════════════════════════════════

# Ports. start-static.sh reads these from this file. POCKETBASE_PORT
# also rewrites POCKETBASE_URL above on each boot, so changing it here
# is enough — no other edits needed. See docs/PORTS.md for details.
# PORT=3000
# POCKETBASE_PORT=8090

# Jamendo (Creative Commons music) — used by /search empty fallback and
# /api/tracks/[id]. Leave the placeholder if you don't care about Jamendo.
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Anthropic (Claude) API key. Optional — two features use it:
#   1. AI triage of bug reports (SETUP.md → "Bug reports"). Without a key,
#      reports send as normal, just without the diagnosis.
#   2. The AI-fallback lyrics generator documented in docs/LYRICS_AI.md (planned).
ANTHROPIC_API_KEY=

# Model for bug-report triage. Default claude-sonnet-5; set
# claude-haiku-4-5-20251001 for a cheaper, shallower read.
# BUG_TRIAGE_MODEL=

# Anthropic API base URL. Only for pointing tests at a fake server.
# ANTHROPIC_BASE_URL=

# Desktop auto-update. The desktop apps ask THIS server whether a newer build
# exists; the server answers from the GitHub Release and streams the installer
# back. The repo is private, so it needs a read-only token — kept here on the
# host, never shipped inside the app.
#
# Make one at github.com/settings/tokens (fine-grained) → this repo only →
# Repository permissions → Contents: Read-only.
# Without it the feed just reports "no update" and the apps keep working.
GITHUB_RELEASES_TOKEN=
# Override only if the repo moves, or for tests against a fake API.
# GITHUB_RELEASES_REPO=ParalelSt/ember
# GITHUB_API_BASE=https://api.github.com

# Google sign-in for the YouTube Music likes transfer (Settings, Library,
# Transfer, Liked songs, YouTube Music). Without these two the option still
# shows, says this server is not set up for it, and offers a playlist link.
# One-time setup, step by step (docs/imports.md, section 11, has more):
#   1. console.cloud.google.com: create a project, call it Ember.
#   2. APIs & Services > Library: enable "YouTube Data API v3".
#   3. APIs & Services > OAuth consent screen: External, app name Ember,
#      your email as contact.
#   4. Press "Publish app" so ANY Google account can do the import, with no
#      list to keep. Google then shows everyone an "unverified app" warning
#      (Ember tells them to expect it and press Continue) and allows at most
#      100 different accounts until Google reviews the app. Leaving it in
#      Testing instead means adding each person's email as a test user.
#   5. Credentials > Create credentials > OAuth client ID > type "TVs and
#      Limited Input devices". Copy the Client ID and the Client secret here.
#   6. Restart Ember.
# What a friend sees: a short code in Ember, google.com/device where they
# type it, "Google hasn't verified this app" (press Continue or Advanced,
# then Go to Ember), "View your
# YouTube account" (press Continue), then the preview back in Ember.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only for pointing tests at a fake Google.
# GOOGLE_OAUTH_BASE=https://oauth2.googleapis.com
# YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3

# Discord rich presence — rate-limited 1/15s.
DISCORD_APP_ID=

# Bug-report Discord webhook. Owner: edit DEFAULT_WEBHOOK_URL in
# apps/web/app/api/bug-report/route.ts to ship the bug-report channel
# baked into source. Anyone else: set this env var to override per
# deployment. Without either → "Report a bug" returns a 503.
DISCORD_BUG_REPORT_WEBHOOK_URL=

# Where audio comes from when it isn't downloaded yet.
#   (unset, the DEFAULT) = download it, then serve from disk. Reliable: a
#      played song lives on the host forever and can never 403 again.
#   proxy = stream YouTube through live. Faster the first time, but this is
#      the path that produces 403s, and native players trip over it badly.
# STREAM_MODE=proxy
# STREAM_CACHE_WARM=0

# Python venv + player.py + cache dir overrides. Only set if your layout
# differs from the bundled .venv/. MUSIC_DIR also controls where the
# YouTube stream proxy looks for cached audio files.
# PYTHON_BIN=
# PLAYER_SCRIPT=
# MUSIC_DIR=

# Same-origin web build leaves this empty. Native (Capacitor) shells set
# it to the server's absolute URL.
NEXT_PUBLIC_API_BASE_URL=
