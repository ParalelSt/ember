# systemd user unit: Ember (PocketBase + the web app) under start-static.sh's
# watchdog, started at boot, with no terminal or tmux involved. Use this OR
# tmux, not both. See SETUP.md, "Run Ember at boot (systemd, optional)".
#
# Install, as the user that owns the Ember folder (not root):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/ember.service ~/.config/systemd/user/
#   # Ember not in ~/ember? Fix WorkingDirectory and ExecStart below.
#   # `which node` not in PATH below? Add its folder to PATH.
#   systemctl --user daemon-reload
#   systemctl --user enable --now ember
#   sudo loginctl enable-linger "$USER"   # keeps it running while nobody is logged in
#
# It serves the existing build (--no-build): ./update.sh builds before it
# restarts the unit, so a boot is quick and never waits on a build.
#
# Day to day:
#   systemctl --user status ember       is it running?
#   journalctl --user -u ember -f       its output (also in logs/*.log)
#   ./update.sh                         updates, then restarts it through systemd
#
# Stopping: systemd sends SIGTERM to the watchdog alone (KillMode=mixed). The
# watchdog stops both services itself, giving each STOP_GRACE (8 s) before a
# SIGKILL, and does not report that as a crash. Its worst case is both
# services stuck, 2 x 14 s; TimeoutStopSec is above that, and only then does
# systemd SIGKILL whatever is left in the unit.
#
# Restarts: the watchdog restarts a crashed service itself. systemd restarts
# the watchdog only if it fails (a failed build, a busy port), every 30 s, and
# gives up after 5 tries in 10 minutes.

[Unit]
Description=Ember (PocketBase + web app, supervised by start-static.sh)
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/ember
ExecStart=%h/ember/start-static.sh --no-build
# systemd's own PATH has no nvm or ~/.local; node, npx, lsof, curl and git
# must all be found here.
Environment=PATH=%h/.nvm/versions/node/v24.13.0/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=35
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
