{
  "name": "spotify-clone",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "deploy": "npm run build && systemctl --user restart ember && echo '\u2713 rebuilt + ember restarted'",
    "test:privacy": "node tests/privacy.test.mjs"
  }
}
