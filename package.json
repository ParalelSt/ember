{
  "name": "spotify-clone",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test:triage": "node tests/ai-triage.test.mjs",
    "test:triage-ui": "node tests/ai-triage-ui.test.mjs",
    "deploy": "npm run build && systemctl --user restart ember && echo '✓ rebuilt + ember restarted'"
  }
}
